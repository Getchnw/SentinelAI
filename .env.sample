# =============================================================================
# SentinelAI Environment Variables Template
# Copy this file to .env and fill in your actual values
# =============================================================================

# Backend Configuration
# =====================

# LLM Model Selection
# Options:
#   - "ollama/llama3.1"    (local Ollama, recommended for development)
#   - "ollama/llama2"      (alternative Ollama model)
#   - "gpt-4o"             (OpenAI, requires OPENAI_API_KEY)
#   - "gpt-4"              (OpenAI)
#   - "claude-3-opus"      (Anthropic, requires ANTHROPIC_API_KEY)
LLM_MODEL=ollama/llama3.1

# Ollama Configuration (required if LLM_MODEL starts with "ollama/")
# Point to your Ollama server URL
OLLAMA_URL=http://localhost:11434

# OpenAI Configuration (required if using gpt-4o or gpt-4)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic Configuration (required if using Claude models)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Backend Server
# ==================
# FastAPI host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Enable debug mode (True/False)
DEBUG=False

# Semgrep Configuration
# =====================
# Semgrep config file path (optional, uses default if not specified)
# SEMGREP_CONFIG=~/.semgrep.yml

# Enable detailed Semgrep logging (True/False)
SEMGREP_DEBUG=False

# Extension Configuration
# =======================
# VS Code Extension backend URL
VSCODE_SENTINELAI_BACKEND_URL=http://localhost:8000

# =============================================================================
# Setup Instructions
# =============================================================================
#
# 1. For Local Development (Ollama):
#    - Install Ollama: https://ollama.ai/
#    - Start Ollama: ollama serve
#    - Pull llama3.1 model: ollama pull llama3.1
#    - Copy this file: cp .env.sample .env
#    - Run backend: cd apps/backend && python -m uvicorn app.main:app --reload
#
# 2. For OpenAI:
#    - Get API key: https://platform.openai.com/api-keys
#    - Set LLM_MODEL=gpt-4o
#    - Set OPENAI_API_KEY=sk-...
#
# 3. For Production:
#    - Set DEBUG=False
#    - Use a proper LLM provider (not local Ollama)
#    - Set appropriate BACKEND_URL
#
# =============================================================================
